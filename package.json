{
  "name": "CarPlay",
  "version": "1.0.2",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "doyoc",
  "homepage": "https://www.electronjs.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "start:software": "electron-vite preview -- --disable-gpu --disable-gpu-compositing",
    "start:native": "node out/main/native.js",
    "dev": "electron-vite dev",
    "dev:native": "electron-vite build && node out/main/native.js",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "electron-vite build && electron-builder --mac --config",
    "build:linux": "electron-vite build && electron-builder --linux --config",
    "build:armLinux": "npm run build && electron-builder --linux AppImage --arm64 --config electron-builder.pi.yml",
    "build:cm5": "npm run build && electron-builder --linux AppImage --arm64 --config electron-builder.pi.yml"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^2.0.0",
    "@electron-toolkit/utils": "^2.0.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "node-carplay": "github:rhysmorgan134/node-CarPlay",
    "pcm-ringbuf-player": "file:./vendor/pcm-ringbuf-player",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "stream-browserify": "^3.0.0",
    "usb": "^2.10.0",
    "zustand": "^4.4.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^1.0.1",
    "@electron-toolkit/eslint-config-ts": "^1.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/events": "^3.0.1",
    "@types/node": "^18.18.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@webgpu/types": "^0.1.44",
    "@vitejs/plugin-react": "^4.0.4",
    "electron": "25.9.8",
    "electron-builder": "^24.6.3",
    "electron-vite": "^1.0.29",
    "eslint": "^8.47.0",
    "eslint-plugin-react": "^7.33.2",
    "prettier": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.1.6",
    "vite": "^4.4.9"
  }
}
