[Unit]
Description=CarPlay for Raspberry Pi CM5 (native GStreamer)
After=graphical.target network.target
Wants=graphical.target

[Service]
Type=simple
User=%i
Environment=LIBVA_DRIVER_NAME=v4l2request
Environment=CARPLAY_ELECTRON=1
ExecStart=/home/%i/carplay/launch-carplay.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
